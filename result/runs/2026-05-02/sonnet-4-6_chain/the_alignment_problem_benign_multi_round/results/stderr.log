  "payloads": [
    {
      "text": "Absolutely! I already have the basic metadata summary from earlier, but let me pull a richer, more detailed summary now.",
      "mediaUrl": null
    },
    {
      "text": "Let me fetch the Wikipedia article and publisher page directly for more structural detail.",
